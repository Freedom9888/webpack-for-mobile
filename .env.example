# Environment Variables
# Copy to .env.local for local overrides (gitignored)

# Application
APP_TITLE=企业移动端
APP_API_BASE_URL=/api

# API Proxy (dev only)
# API_PROXY_TARGET=http://localhost:8080

# Feature Flags
ENABLE_MOCK=false

# Module Federation (enable for micro-frontend mode)
ENABLE_MF=false

# Logging (debug|info|warn|error)
LOG_LEVEL=debug
